#!/usr/bin/env bash
# Usage: scripts/dev/verify-wp <WP id> <PR number> [--repo owner/name] [--print-pack]
# Exit 0 pass, 1 fail, 2 error. Uses the repo's .venv python when present (needs jsonschema).
set -euo pipefail
root="$(cd "$(dirname "$0")/../.." && pwd)"
py="$root/.venv/bin/python"
[ -x "$py" ] || py=python3
PYTHONPATH="$root/scripts${PYTHONPATH:+:$PYTHONPATH}" exec "$py" -c 'import sys; from aiwf.verifier import main; sys.exit(main(sys.argv[1:]))' "$@"
