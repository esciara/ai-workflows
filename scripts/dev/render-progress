#!/usr/bin/env bash
# Usage: scripts/dev/render-progress [--no-export] [--board docs/board.jsonl]
# Orchestrator only, in the sync PR (ADR-0036): `bd export` -> secret scan (gitleaks) -> docs/board.jsonl -> docs/progress.md.
# --no-export renders from the committed export. Exit 2 on error or a secret finding.
set -euo pipefail
root="$(cd "$(dirname "$0")/../.." && pwd)"
py="$root/.venv/bin/python"
[ -x "$py" ] || py=python3
PYTHONPATH="$root/scripts${PYTHONPATH:+:$PYTHONPATH}" exec "$py" -c 'import sys; from aiwf.progress import main; sys.exit(main(sys.argv[1:]))' "$@"
