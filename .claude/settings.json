{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {"deny": ["Bash(rm -rf *)"]},
  "hooks": {
    "SessionStart": [{"hooks": [{"type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/dev/claims-hook session-start", "timeout": 20}]}],
    "SubagentStop": [{"hooks": [{"type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/dev/claims-hook subagent-stop", "timeout": 30}]}],
    "StopFailure": [{"hooks": [{"type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/dev/claims-hook stop-failure", "timeout": 30}]}],
    "SessionEnd": [{"hooks": [{"type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/dev/claims-hook session-end", "timeout": 20}]}],
    "PreToolUse": [
      {"matcher": "Bash", "hooks": [{"type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/dev/claims-hook pre-bash", "timeout": 5}]},
      {"matcher": "Agent", "hooks": [{"type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/dev/claims-hook pre-agent", "timeout": 20}]}
    ],
    "PostToolUse": [
      {"matcher": "TaskStop", "hooks": [{"type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/dev/claims-hook task-stop", "timeout": 30}]},
      {"matcher": "Agent", "hooks": [{"type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/dev/claims-hook post-agent", "timeout": 10}]},
      {"matcher": "SendMessage", "hooks": [{"type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/dev/claims-hook post-send", "timeout": 10}]}
    ]
  }
}
