{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ping agent answer",
  "type": "object",
  "properties": {
    "reply": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[^@<>\\n\\r`]*$",
      "description": "One short line; no mentions, HTML, markers or code."
    }
  },
  "required": ["reply"],
  "additionalProperties": false
}
