{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Classifier answer (Workflow B, B1 pass 2)",
  "type": "object",
  "properties": {
    "type": {
      "enum": [
        "bug",
        "feature",
        "question"
      ],
      "description": "Issue class."
    },
    "confidence": {
      "description": "Of the class. low: a maintainer takes over (triage: needs-human).",
      "enum": [
        "high",
        "medium",
        "low"
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[^@<>\\n\\r`]*$",
      "description": "One line; no mentions, HTML, markers or code."
    },
    "duplicate_of": {
      "type": "object",
      "properties": {
        "number": {
          "type": "integer",
          "minimum": 1,
          "description": "A candidate issue from the context that reports the same problem."
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low"
          ]
        }
      },
      "required": [
        "number",
        "confidence"
      ],
      "additionalProperties": false
    },
    "possibly_fixed_by": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "commit",
            "pr"
          ]
        },
        "ref": {
          "type": "string",
          "pattern": "^([0-9a-f]{7,40}|[1-9][0-9]{0,8})$",
          "description": "Commit SHA (prefix as listed) or PR number."
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low"
          ]
        }
      },
      "required": [
        "kind",
        "ref",
        "confidence"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "type",
    "confidence",
    "reason"
  ],
  "additionalProperties": false
}
